#list slicing==>
#list[starting_index:ending_index] #ending index is not included in the slice.

marks= [90, 80, 70, 60, 50]
print(marks[1:4]) #
print(marks[:3]) #same as marks[0:3]
print(marks[2:]) #same as marks[2:5]
print(marks[-3:-1]) #same as marks[2:4]

