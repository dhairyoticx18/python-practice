        self.name = name
        self.marks = marks

    @staticmethod     #decorator ( iske bina eror ayega agar run karoge toh)
    def hello():        #agar kisi method mai self ki jarurt nahi hai yha hame nahi lagana hai toh ham static method ka use karte ha jisse hamara funcction bina self ke run hojata hai)
        print("hello boss")

    def get_avg (self):
        sum=0
        for val in self.marks: 
            sum += val 
            print("hi", self.name, "your avg score is :", sum/3)

